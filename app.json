{
  "expo": {
    "name": "Script Cue",
    "slug": "script-cue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scriptcue",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Necesitamos acceso al micrófono para grabar tus sesiones de estudio y detectar la lectura de tus líneas.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.alexdiaz.scriptcue"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.alexdiaz.scriptcue"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7084f548-a9ac-4d2a-844d-86d8ecfa06bd"
      },
      "appIdBase": {
        "ios": "com.alexdiaz.scriptcue",
        "android": "com.alexdiaz.scriptcue"
      },
      "appIdEffective": {
        "ios": "com.alexdiaz.scriptcue",
        "android": "com.alexdiaz.scriptcue"
      },
      "appIdSuffix": "",
      "mergeServerUrl": "https://script-cue-merge-server.onrender.com"
    },
    "owner": "alexx223",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7084f548-a9ac-4d2a-844d-86d8ecfa06bd"
    }
  }
}