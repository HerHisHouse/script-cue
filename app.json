{
  "expo": {
    "name": "ScriptCue",
    "slug": "script-cue",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "scriptcue",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Necesitamos acceso al micrófono para grabar tus sesiones de estudio y detectar la lectura de tus líneas.",
        "NSPhotoLibraryUsageDescription": "Necesitamos acceso a tus fotos para guardar las grabaciones de tus ensayos.",
        "NSPhotoLibraryAddUsageDescription": "Necesitamos acceso a tus fotos para guardar las grabaciones de tus ensayos.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "script-cue-merge-server.onrender.com": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        }
      },
      "bundleIdentifier": "es.scriptcue.app",
      "buildNumber": "36"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Necesitamos acceso a la cámara para grabar tus sesiones en modo casting.",
          "microphonePermission": "Necesitamos acceso al micrófono para grabar tus sesiones de estudio y detectar la lectura de tus líneas."
        }
      ],
      "./plugins/withAndroidNetworkConfig.js",
      "./plugins/withAudioEchoCancellation.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "es.scriptcue.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-android-morado.png",
        "monochromeImage": "./assets/images/logo-android-morado.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO"
      ],
      "versionCode": 21
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7084f548-a9ac-4d2a-844d-86d8ecfa06bd"
      }
    },
    "owner": "alexx223",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7084f548-a9ac-4d2a-844d-86d8ecfa06bd"
    }
  }
}
